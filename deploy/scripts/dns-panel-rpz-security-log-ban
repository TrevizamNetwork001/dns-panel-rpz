#!/bin/sh
# Chamado pelo fail2ban (action dns-panel-hook) a cada ban/unban do jail sshd.
# Roda o artisan dentro do container 'app' já em execução (docker compose exec),
# já que desde a migração para Docker não há mais PHP instalado no host.
set -eu
cd /opt/dns-panel-rpz
# Explicit recovered runtime: never fall back to the legacy compose.yml.
exec /usr/bin/docker compose -f compose.staging.yml exec -T app php artisan security:log-ban "$1" "$2" "$3"
