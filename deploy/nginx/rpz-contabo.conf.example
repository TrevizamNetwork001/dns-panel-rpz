# REVIEW ONLY. Not installed, enabled or tested with real certificates.
# Future gateway on native Contabo IPv4/IPv6, keeping FPM private.
# The preparation Compose has NO port mapping: 127.0.0.1:8083 is a future,
# separately approved loopback mapping. Existing staging uses 8082.
server {
    listen 213.199.47.105:443 ssl;
    listen [2a02:c207:2368:3678::1]:443 ssl;
    server_name rpz.trevizamnetwork.com.br;
    ssl_certificate /etc/nginx/tls/rpz.trevizamnetwork.com.br/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/rpz.trevizamnetwork.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 26m;
    server_tokens off;

    # Delivery remains blocked independently of the application flags.
    location ~ ^/(rpz|mikrotik)/ { return 503; }

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_redirect off;
    }
}
