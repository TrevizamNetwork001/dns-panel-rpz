# Non-secret Compose parameters only. Do not copy over .env.staging or original key.
CONTABO_RELEASE=contabo-review
CONTABO_RUNTIME_ENV_FILE=/etc/dns-panel-rpz/contabo.env
# Reuse the ORIGINAL APP_KEY via the existing secure secret source in the runtime
# file. Do not generate, rotate, print or commit the key. This file is NOT runtime.
# Runtime: APP_URL, original APP_KEY, SESSION_SECURE_COOKIE=true,
# SESSION_HTTP_ONLY=true, CACHE_STORE=database, SESSION_DRIVER=database,
# ANATEL_PYTHON_BIN=/opt/anatel-venv/bin/python, trusted proxy CIDRs reviewed.
# Safety flags are forced by compose.contabo.yml; its isolated network has no egress.
